# Local SQLite (default):
DATABASE_URL="file:./dev.db"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-this-to-a-random-secret-in-production"
AUTH_SECRET="change-this-to-a-random-secret-in-production"
UPLOAD_DIR="./uploads"

# Google Gemini API key — required for AI Vision extraction of scanned PDFs and photos.
# Get a key at https://aistudio.google.com/app/apikey
# Add this to Vercel → Settings → Environment Variables for production deployments.
GEMINI_API_KEY="your-gemini-api-key-here"
